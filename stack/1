<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>STACK DROP</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  body {
    background: #0f0f14;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    overflow: hidden;
    font-family: 'Arial Rounded MT Bold', Arial, sans-serif;
    touch-action: none;
    user-select: none;
  }
  canvas { display: block; }
</style>
</head>
<body>
<canvas id="game"></canvas>
<script>
// ═══════════════════════════════════════════════════════════
//  STACK DROP  —  Mobile cube-stacking game
// ═══════════════════════════════════════════════════════════

const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');

// ── Responsive canvas ──
function resize() {
  canvas.width  = Math.min(window.innerWidth, 420);
  canvas.height = window.innerHeight;
}
resize();
window.addEventListener('resize', resize);

// ─────────────────────────────────────────────────────────────
//  DESIGN SYSTEM
// ─────────────────────────────────────────────────────────────
// Each entry: [face, right-side, bottom-side]
const PALETTE = [
  ['#FF3CAC','#C4006E','#8A0050'],   // hot pink
  ['#FFD300','#C8A000','#8A6E00'],   // electric yellow
  ['#00E5FF','#009DB5','#006477'],   // cyan
  ['#7B2FFF','#5000D0','#320083'],   // violet
  ['#FF6B00','#C44E00','#883400'],   // orange
  ['#00FF9C','#00C46E','#008047'],   // mint
  ['#FF2D55','#B5001F','#7A0015'],   // red
  ['#38CAFF','#007BAD','#004D6E'],   // sky
];

const BG_THEMES = [
  ['#0f0f14','#1a0a2e'],
  ['#0a1628','#001a3a'],
  ['#1a0808','#2d0015'],
  ['#0a1a0a','#001a10'],
  ['#1a100a','#2d1500'],
];

// ─────────────────────────────────────────────────────────────
//  STATE
// ─────────────────────────────────────────────────────────────
let state = 'start';  // start | playing | gameover
let score = 0, level = 1, combo = 0;
let bestScore = parseInt(localStorage.getItem('sd_best') || '0');

let stack = [];         // settled cubes
let dropping = null;    // active falling cube
let platform = null;    // moving base platform
let particles = [];
let floatTexts = [];
let screenShake = 0;
let gameOverTimer = 0, gameOverGrey = 0;
let levelUpTimer = 0;
let bgCur = [...BG_THEMES[0]], bgNext = [...BG_THEMES[0]], bgT = 1;

// ─────────────────────────────────────────────────────────────
//  LEVEL CONFIG
// ─────────────────────────────────────────────────────────────
function cfg(lvl = level) {
  const CUBE_W   = Math.round(Math.min(canvas.width * 0.22, 88));
  const CUBE_H   = Math.round(CUBE_W * 0.52);
  const PLAT_W   = Math.round(Math.min(canvas.width * 0.50 - (lvl - 1) * 3, canvas.width * 0.50));
  const PLAT_H   = Math.round(CUBE_H * 0.42);
  const SPEED    = Math.min(1.6 + (lvl - 1) * 0.28, 6.2);
  return { CUBE_W, CUBE_H, PLAT_W, PLAT_H, SPEED };
}

// ─────────────────────────────────────────────────────────────
//  FLAT-3D CUBE RENDERER
// ─────────────────────────────────────────────────────────────
function drawCube(x, y, w, h, colors, alpha = 1, squish = 1) {
  const DEPTH = Math.round(w * 0.20);
  const [FACE, RIGHT, BOT] = colors;

  // Squish anchors bottom of cube
  const sh   = Math.round(h * squish);      // squished height
  const offY = h - sh;                       // shift down so base stays fixed

  const x0 = Math.round(x),     y0 = Math.round(y + offY);        // face top-left
  const x1 = x0 + Math.round(w), y1 = y0 + sh;                    // face bottom-right

  ctx.save();
  ctx.globalAlpha = alpha;

  // Drop shadow ellipse
  ctx.save();
  ctx.globalAlpha = alpha * 0.25;
  ctx.fillStyle = '#000';
  ctx.beginPath();
  ctx.ellipse(x0 + w / 2 + DEPTH / 2, y + h + DEPTH + 6, w * 0.40, 6, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();

  // Bottom-depth face
  ctx.fillStyle = BOT;
  ctx.beginPath();
  ctx.moveTo(x0,          y1);
  ctx.lineTo(x0 + DEPTH,  y1 + DEPTH);
  ctx.lineTo(x1 + DEPTH,  y1 + DEPTH);
  ctx.lineTo(x1,          y1);
  ctx.closePath();
  ctx.fill();

  // Right-depth face
  ctx.fillStyle = RIGHT;
  ctx.beginPath();
  ctx.moveTo(x1,          y0);
  ctx.lineTo(x1 + DEPTH,  y0 + DEPTH);
  ctx.lineTo(x1 + DEPTH,  y1 + DEPTH);
  ctx.lineTo(x1,          y1);
  ctx.closePath();
  ctx.fill();

  // Front face
  ctx.fillStyle = FACE;
  ctx.fillRect(x0, y0, Math.round(w), sh);

  // Shine strip
  ctx.fillStyle = 'rgba(255,255,255,0.13)';
  ctx.fillRect(x0 + 4, y0 + 3, Math.round(w * 0.32), Math.max(4, Math.round(sh * 0.22)));

  ctx.restore();
}

// Wider, shorter platform variant
function drawPlatform(x, y, w, h, colorIdx) {
  drawCube(x, y, w, h, PALETTE[colorIdx % PALETTE.length]);
}

// ─────────────────────────────────────────────────────────────
//  PARTICLES
// ─────────────────────────────────────────────────────────────
function spawnBurst(cx, cy, colors, count = 16, big = false) {
  for (let i = 0; i < count; i++) {
    const a = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.6;
    const spd = big ? 3 + Math.random() * 7 : 1.5 + Math.random() * 4;
    particles.push({
      x: cx, y: cy,
      vx: Math.cos(a) * spd,
      vy: Math.sin(a) * spd - (big ? 2 : 0.5),
      r:  big ? 5 + Math.random() * 8 : 3 + Math.random() * 4,
      color: colors[Math.floor(Math.random() * 2)],
      life: 1, decay: 0.022 + Math.random() * 0.018,
      rot: Math.random() * Math.PI * 2, rotV: (Math.random() - 0.5) * 0.18,
    });
  }
}

function spawnConfetti(count = 40) {
  for (let i = 0; i < count; i++) {
    particles.push({
      x: Math.random() * canvas.width, y: -16,
      vx: (Math.random() - 0.5) * 3.5, vy: 1.8 + Math.random() * 3,
      r: 5 + Math.random() * 7,
      color: PALETTE[Math.floor(Math.random() * PALETTE.length)][0],
      life: 1, decay: 0.006 + Math.random() * 0.007,
      rot: Math.random() * Math.PI * 2, rotV: (Math.random() - 0.5) * 0.18,
      confetti: true,
    });
  }
}

function tickParticles() {
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx; p.y += p.vy;
    p.vy += 0.18; p.vx *= 0.97;
    p.rot += p.rotV;
    p.life -= p.decay;
    if (p.life <= 0) particles.splice(i, 1);
  }
}

function drawParticles() {
  for (const p of particles) {
    ctx.save();
    ctx.globalAlpha = Math.max(0, p.life);
    ctx.translate(p.x, p.y);
    ctx.rotate(p.rot);
    ctx.fillStyle = p.color;
    if (p.confetti) {
      ctx.fillRect(-p.r / 2, -p.r / 4, p.r, p.r / 2);
    } else {
      ctx.beginPath();
      ctx.arc(0, 0, p.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }
}

// ─────────────────────────────────────────────────────────────
//  FLOATING TEXT
// ─────────────────────────────────────────────────────────────
const COMBO_LABELS = ['','','NICE!','PERFECT!','AMAZING!!','ON FIRE!','UNSTOPPABLE!'];
function spawnText(x, y, label, big = false) {
  floatTexts.push({ x, y, label, big, life: 1, decay: 0.016, vy: -1.4 });
}

function tickTexts() {
  for (let i = floatTexts.length - 1; i >= 0; i--) {
    floatTexts[i].y += floatTexts[i].vy;
    floatTexts[i].life -= floatTexts[i].decay;
    if (floatTexts[i].life <= 0) floatTexts.splice(i, 1);
  }
}

function drawTexts() {
  for (const t of floatTexts) {
    const sz = t.big ? 28 : 20;
    ctx.save();
    ctx.globalAlpha = Math.min(1, t.life * 2.5);
    ctx.textAlign = 'center';
    ctx.font = `900 ${sz}px Arial, sans-serif`;
    ctx.lineWidth = 4;
    ctx.strokeStyle = 'rgba(0,0,0,0.7)';
    ctx.strokeText(t.label, t.x, t.y);
    ctx.fillStyle = t.big ? '#FFD300' : '#fff';
    ctx.fillText(t.label, t.x, t.y);
    ctx.restore();
  }
}

// ─────────────────────────────────────────────────────────────
//  GAME INIT
// ─────────────────────────────────────────────────────────────
function initGame() {
  const c = cfg();
  stack = []; particles = []; floatTexts = [];
  dropping = null;
  combo = 0; screenShake = 0;

  const platY = Math.round(canvas.height * 0.80);
  platform = {
    x: Math.round((canvas.width - c.PLAT_W) / 2),
    y: platY,
    w: c.PLAT_W,
    h: c.PLAT_H,
    dir: 1,
    colorIdx: 0,
  };

  queueCube();
}

function queueCube() {
  if (state !== 'playing') return;
  const c = cfg();
  const fromLeft = Math.random() < 0.5;
  const colorIdx = (stack.length + 1) % PALETTE.length;
  const startX = fromLeft ? -c.CUBE_W - 10 : canvas.width + 10;

  dropping = {
    x:       startX,
    y:       getNextLandY() - c.CUBE_H * 1.6,
    w:       c.CUBE_W,
    h:       c.CUBE_H,
    vy:      0,
    vx:      fromLeft ? 5.5 : -5.5,
    phase:   'swoop',  // swoop | hold | fall | bounce | settled
    squish:  1,
    squishV: 0,
    bounces: 0,
    colorIdx,
    colors: PALETTE[colorIdx],
  };
}

// Y-coordinate of the top surface to land on
function getNextLandY() {
  if (stack.length === 0) return platform.y;
  return stack[stack.length - 1].y;
}
function getTopX() { return stack.length ? stack[stack.length - 1].x : platform.x; }
function getTopW() { return stack.length ? stack[stack.length - 1].w : platform.w; }

// ─────────────────────────────────────────────────────────────
//  UPDATE PLATFORM
// ─────────────────────────────────────────────────────────────
function tickPlatform() {
  if (state !== 'playing') return;
  const c = cfg();
  platform.x += c.SPEED * platform.dir;
  const margin = 12;
  if (platform.x + platform.w > canvas.width - margin) {
    platform.x = canvas.width - margin - platform.w;
    platform.dir = -1;
  }
  if (platform.x < margin) {
    platform.x = margin;
    platform.dir = 1;
  }
  // Keep platform width updated per level
  platform.w = c.PLAT_W;
  platform.h = c.PLAT_H;
}

// ─────────────────────────────────────────────────────────────
//  UPDATE DROPPING CUBE
// ─────────────────────────────────────────────────────────────
const GRAVITY   = 0.58;
const BOUNCE_EL = 0.35;  // elasticity

function tickDropping() {
  if (!dropping) return;

  // ── Squish spring ──
  if (dropping.squishV !== 0) {
    dropping.squish += dropping.squishV;
    dropping.squishV *= 0.70;
    dropping.squish  = Math.max(0.65, Math.min(1.2, dropping.squish));
    if (Math.abs(dropping.squish - 1) < 0.008 && Math.abs(dropping.squishV) < 0.003) {
      dropping.squish = 1; dropping.squishV = 0;
    }
  }

  // ── SWOOP: slide cube to centre from side ──
  if (dropping.phase === 'swoop') {
    dropping.x += dropping.vx;
    const centre = (canvas.width - dropping.w) / 2;
    const passed = dropping.vx > 0 ? dropping.x >= centre : dropping.x <= centre;
    if (passed) {
      dropping.x  = centre;
      dropping.vx = 0;
      dropping.phase = 'hold';
    }
    return;
  }

  // ── HOLD: waiting for tap ──
  if (dropping.phase === 'hold') return;

  // ── FALL / BOUNCE ──
  dropping.vy += GRAVITY;
  dropping.y  += dropping.vy;

  const landY    = getNextLandY() - dropping.h;
  const baseX    = getTopX();
  const baseW    = getTopW();

  if (dropping.y >= landY) {
    dropping.y = landY;
    const overL = Math.max(dropping.x, baseX);
    const overR = Math.min(dropping.x + dropping.w, baseX + baseW);
    const overlap = overR - overL;

    if (overlap <= 4) {
      // missed
      triggerGameOver();
      return;
    }

    if (Math.abs(dropping.vy) > 3.5) {
      // Bounce!
      dropping.vy  = -dropping.vy * BOUNCE_EL;
      dropping.squishV = -0.14;
      dropping.squish  = 0.72;
      dropping.phase = 'bounce';
      dropping.bounces++;
      screenShake = 5;
      spawnBurst(dropping.x + dropping.w / 2, landY + dropping.h, dropping.colors, 8);
    } else {
      // Settle
      dropping.vy = 0;
      settle(overlap, overL);
    }
  }

  // Safety: fell off screen
  if (dropping.y > canvas.height + 150) {
    triggerGameOver();
  }
}

// ─────────────────────────────────────────────────────────────
//  SETTLE CUBE ONTO STACK
// ─────────────────────────────────────────────────────────────
function settle(overlap, overlapLeft) {
  if (!dropping) return;

  const baseW     = getTopW();
  const baseX     = getTopX();
  const precision = overlap / baseW;   // 0..1

  let newX = overlapLeft;
  let newW = overlap;

  const PERFECT_THRESH = 0.90;
  const GOOD_THRESH    = 0.60;

  if (precision >= PERFECT_THRESH) {
    // ── PERFECT ── snap to base, no trim
    newX = baseX + (baseW - dropping.w) / 2;
    newW = dropping.w;
    combo++;
    score += 10 + combo * 5;
    screenShake = combo >= 3 ? 14 : 8;
    spawnBurst(newX + newW / 2, dropping.y, dropping.colors, combo >= 3 ? 28 : 18, combo >= 3);
    if (combo >= 3) spawnConfetti(35);
    const label = COMBO_LABELS[Math.min(combo, COMBO_LABELS.length - 1)];
    if (combo >= 2) spawnText(canvas.width / 2, dropping.y - 20, label, combo >= 3);
  } else if (precision >= GOOD_THRESH) {
    combo = 0;
    score += Math.round(5 * precision);
    screenShake = 4;
    spawnBurst(newX + newW / 2, dropping.y + dropping.h / 2, dropping.colors, 10);
  } else {
    combo = 0;
    score += 1;
    screenShake = 2;
  }

  // Push settled cube
  stack.push({
    x: Math.round(newX),
    y: dropping.y,
    w: Math.round(newW),
    h: dropping.h,
    colors: dropping.colors,
    colorIdx: dropping.colorIdx,
    squish: 0.78,
    squishV: 0.07,
  });

  dropping = null;

  // Scroll camera up
  scrollCamera();

  // Level progression: every 8 cubes
  if (stack.length % 8 === 0) {
    triggerLevelUp();
  }

  // Spawn next cube after short delay
  setTimeout(() => { if (state === 'playing') queueCube(); }, 320);
}

function scrollCamera() {
  const topY    = stack[stack.length - 1].y;
  const targetY = canvas.height * 0.33;
  if (topY < targetY) {
    const shift = targetY - topY;
    for (const c of stack) c.y += shift;
    platform.y += shift;
  }
}

function tickStackSquish() {
  for (const c of stack) {
    if (c.squishV === 0) continue;
    c.squish += c.squishV;
    c.squishV *= 0.68;
    c.squish = Math.max(0.70, Math.min(1.15, c.squish));
    if (Math.abs(c.squish - 1) < 0.01) { c.squish = 1; c.squishV = 0; }
  }
}

// ─────────────────────────────────────────────────────────────
//  LEVEL UP / GAME OVER
// ─────────────────────────────────────────────────────────────
function triggerLevelUp() {
  level++;
  levelUpTimer = 100;
  const themeIdx = Math.min(Math.floor((level - 1) / 2), BG_THEMES.length - 1);
  bgNext = [...BG_THEMES[themeIdx]];
  bgT = 0;
  platform.colorIdx = (platform.colorIdx + 1) % PALETTE.length;
  spawnConfetti(55);
}

function triggerGameOver() {
  if (state === 'gameover') return;
  state = 'gameover';
  gameOverTimer = 0;
  gameOverGrey  = 0;
  if (score > bestScore) {
    bestScore = score;
    localStorage.setItem('sd_best', bestScore);
  }
}

// ─────────────────────────────────────────────────────────────
//  BACKGROUND
// ─────────────────────────────────────────────────────────────
function lerpHex(a, b, t) {
  const p = (h) => [parseInt(h.slice(1,3),16), parseInt(h.slice(3,5),16), parseInt(h.slice(5,7),16)];
  const [ar,ag,ab] = p(a), [br,bg,bb] = p(b);
  return `rgb(${~~(ar+(br-ar)*t)},${~~(ag+(bg-ag)*t)},${~~(ab+(bb-ab)*t)})`;
}

function drawBG() {
  if (bgT < 1) {
    bgT = Math.min(1, bgT + 0.025);
    if (bgT >= 1) bgCur = [...bgNext];
  }
  const c0 = bgT < 1 ? lerpHex(bgCur[0], bgNext[0], bgT) : bgCur[0];
  const c1 = bgT < 1 ? lerpHex(bgCur[1], bgNext[1], bgT) : bgCur[1];
  const g = ctx.createLinearGradient(0, 0, 0, canvas.height);
  g.addColorStop(0, c0);
  g.addColorStop(1, c1);
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // Subtle dot grid
  ctx.save();
  ctx.globalAlpha = 0.05;
  ctx.fillStyle = '#fff';
  const step = 36;
  for (let x = step; x < canvas.width; x += step) {
    for (let y = step; y < canvas.height; y += step) {
      ctx.beginPath();
      ctx.arc(x, y, 1, 0, Math.PI * 2);
      ctx.fill();
    }
  }
  ctx.restore();
}

// ─────────────────────────────────────────────────────────────
//  DRAW GAME WORLD
// ─────────────────────────────────────────────────────────────
function drawWorld() {
  const sx = screenShake > 0 ? (Math.random() - 0.5) * screenShake : 0;
  const sy = screenShake > 0 ? (Math.random() - 0.5) * screenShake * 0.4 : 0;
  if (screenShake > 0) screenShake *= 0.75;

  ctx.save();
  ctx.translate(~~sx, ~~sy);

  // Platform
  drawPlatform(platform.x, platform.y, platform.w, platform.h, platform.colorIdx);

  // Settled stack
  for (const c of stack) {
    drawCube(c.x, c.y, c.w, c.h, c.colors, 1, c.squish);
  }

  // Dropping cube
  if (dropping) {
    const alpha = dropping.phase === 'swoop'
      ? 0.5 + 0.5 * (1 - Math.abs(dropping.x - (canvas.width - dropping.w) / 2) / (canvas.width / 2))
      : 1;
    drawCube(dropping.x, dropping.y, dropping.w, dropping.h, dropping.colors, alpha, dropping.squish);

    // Drop guide (dashed ghost)
    if (dropping.phase === 'hold') {
      const landY = getNextLandY() - dropping.h;
      ctx.save();
      ctx.globalAlpha = 0.15;
      ctx.setLineDash([5, 7]);
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(dropping.x, landY, dropping.w, dropping.h);
      ctx.beginPath();
      ctx.moveTo(dropping.x + dropping.w / 2, dropping.y + dropping.h);
      ctx.lineTo(dropping.x + dropping.w / 2, landY);
      ctx.stroke();
      ctx.restore();
    }
  }

  ctx.restore();
}

// ─────────────────────────────────────────────────────────────
//  HUD
// ─────────────────────────────────────────────────────────────
function drawHUD() {
  ctx.save();
  ctx.textAlign = 'center';

  // Score — large
  ctx.font = '900 48px Arial, sans-serif';
  ctx.lineWidth = 3;
  ctx.strokeStyle = 'rgba(0,0,0,0.35)';
  ctx.strokeText(score, canvas.width / 2, 62);
  ctx.fillStyle = '#fff';
  ctx.fillText(score, canvas.width / 2, 62);

  // Level pill
  const pillW = 78, pillH = 24;
  const pillX = (canvas.width - pillW) / 2, pillY = 70;
  ctx.fillStyle = 'rgba(255,255,255,0.12)';
  ctx.beginPath();
  ctx.roundRect(pillX, pillY, pillW, pillH, 12);
  ctx.fill();
  ctx.font = '700 12px Arial, sans-serif';
  ctx.fillStyle = 'rgba(255,255,255,0.65)';
  ctx.fillText(`LEVEL ${level}`, canvas.width / 2, pillY + 16);

  // Combo dots
  if (combo > 1) {
    const DOT = 5, GAP = 13;
    const totalW = (Math.min(combo, 8) - 1) * GAP;
    const sx = canvas.width / 2 - totalW / 2;
    for (let i = 0; i < Math.min(combo, 8); i++) {
      ctx.beginPath();
      ctx.arc(sx + i * GAP, pillY + pillH + 11, DOT, 0, Math.PI * 2);
      ctx.fillStyle = '#FFD300';
      ctx.fill();
    }
  }

  ctx.restore();
}

// ─────────────────────────────────────────────────────────────
//  START SCREEN
// ─────────────────────────────────────────────────────────────
function drawStartScreen() {
  ctx.save();
  ctx.textAlign = 'center';

  // Title
  const titleY = canvas.height * 0.26;
  ctx.font = '900 56px Arial, sans-serif';
  ctx.lineWidth = 7;
  ctx.strokeStyle = PALETTE[3][0];
  ctx.strokeText('STACK', canvas.width / 2, titleY);
  ctx.fillStyle = '#fff';
  ctx.fillText('STACK', canvas.width / 2, titleY);

  ctx.strokeStyle = PALETTE[0][0];
  ctx.strokeText('DROP', canvas.width / 2, titleY + 58);
  ctx.fillStyle = '#fff';
  ctx.fillText('DROP', canvas.width / 2, titleY + 58);

  // Decorative mini stack
  const dW = 72, dH = 22;
  const demoColors = [PALETTE[0], PALETTE[1], PALETTE[2], PALETTE[3], PALETTE[4]];
  for (let i = 0; i < 5; i++) {
    const w = dW - i * 7;
    drawCube((canvas.width - w) / 2, canvas.height * 0.50 - dH * i, w, dH, demoColors[i]);
  }

  // Tap prompt pulse
  const pulse = 0.6 + 0.4 * Math.sin(Date.now() / 420);
  ctx.globalAlpha = pulse;
  ctx.font = '700 17px Arial, sans-serif';
  ctx.fillStyle = '#fff';
  ctx.fillText('TAP TO PLAY', canvas.width / 2, canvas.height * 0.78);

  if (bestScore > 0) {
    ctx.globalAlpha = 0.55;
    ctx.font = '600 14px Arial, sans-serif';
    ctx.fillText(`BEST  ${bestScore}`, canvas.width / 2, canvas.height * 0.84);
  }

  ctx.restore();
}

// ─────────────────────────────────────────────────────────────
//  LEVEL UP BANNER
// ─────────────────────────────────────────────────────────────
function drawLevelUpBanner() {
  if (levelUpTimer <= 0) return;
  levelUpTimer--;
  const t = levelUpTimer / 100;
  const alpha = t < 0.15 ? t / 0.15 : t > 0.75 ? (1 - t) / 0.25 : 1;

  ctx.save();
  ctx.globalAlpha = alpha;
  ctx.textAlign = 'center';

  const by = canvas.height * 0.2;
  ctx.font = '900 34px Arial, sans-serif';
  ctx.strokeStyle = '#000';
  ctx.lineWidth = 5;
  ctx.strokeText(`LEVEL ${level}`, canvas.width / 2, by);
  ctx.fillStyle = '#FFD300';
  ctx.fillText(`LEVEL ${level}`, canvas.width / 2, by);

  ctx.font = '700 14px Arial, sans-serif';
  ctx.fillStyle = '#fff';
  ctx.fillText('FASTER!', canvas.width / 2, by + 22);
  ctx.restore();
}

// ─────────────────────────────────────────────────────────────
//  GAME OVER SCREEN
// ─────────────────────────────────────────────────────────────
function drawGameOver() {
  gameOverTimer++;
  gameOverGrey = Math.min(1, gameOverGrey + 0.035);

  // Desaturating vignette overlay
  ctx.save();
  ctx.globalAlpha = gameOverGrey * 0.62;
  ctx.fillStyle = '#15152a';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.restore();

  if (gameOverTimer < 18) return;

  const enter = Math.min(1, (gameOverTimer - 18) / 35);

  ctx.save();
  ctx.globalAlpha = enter;
  ctx.textAlign = 'center';

  // Dull "game over" treatment — intentionally flat, muted
  ctx.font = '900 36px Arial, sans-serif';
  ctx.fillStyle = 'rgba(195,195,210,0.88)';
  ctx.fillText('GAME OVER', canvas.width / 2, canvas.height * 0.36);

  ctx.font = '600 14px Arial, sans-serif';
  ctx.fillStyle = 'rgba(150,150,168,0.65)';
  ctx.fillText('you missed the stack', canvas.width / 2, canvas.height * 0.36 + 26);

  // Score — large, also muted
  ctx.font = '900 64px Arial, sans-serif';
  ctx.fillStyle = 'rgba(215,215,230,0.92)';
  ctx.fillText(score, canvas.width / 2, canvas.height * 0.52);

  ctx.font = '600 12px Arial, sans-serif';
  ctx.fillStyle = 'rgba(130,130,150,0.65)';
  ctx.fillText('SCORE', canvas.width / 2, canvas.height * 0.52 + 18);

  // New best?
  const newBest = score > 0 && score >= bestScore;
  if (newBest) {
    ctx.font = '700 15px Arial, sans-serif';
    ctx.fillStyle = 'rgba(255,211,0,0.9)';
    ctx.fillText('✦  NEW BEST  ✦', canvas.width / 2, canvas.height * 0.52 + 44);
  } else if (bestScore > 0) {
    ctx.font = '600 13px Arial, sans-serif';
    ctx.fillStyle = 'rgba(130,130,150,0.55)';
    ctx.fillText(`best  ${bestScore}`, canvas.width / 2, canvas.height * 0.52 + 44);
  }

  ctx.font = '600 13px Arial, sans-serif';
  ctx.fillStyle = 'rgba(140,140,160,0.55)';
  ctx.fillText(`level ${level}  ·  ${stack.length} cubes`, canvas.width / 2, canvas.height * 0.61);

  // Retry button (appears after delay)
  if (gameOverTimer > 55) {
    const bAlpha = Math.min(1, (gameOverTimer - 55) / 25);
    ctx.globalAlpha = enter * bAlpha;
    const bx = canvas.width / 2 - 85, by = canvas.height * 0.71 - 22, bw = 170, bh = 46;
    ctx.fillStyle = 'rgba(255,255,255,0.10)';
    ctx.beginPath(); ctx.roundRect(bx, by, bw, bh, 23); ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,0.28)';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.roundRect(bx, by, bw, bh, 23); ctx.stroke();
    ctx.font = '700 17px Arial, sans-serif';
    ctx.fillStyle = 'rgba(255,255,255,0.80)';
    ctx.fillText('TRY AGAIN', canvas.width / 2, canvas.height * 0.71 + 5);
  }

  ctx.restore();
}

// ─────────────────────────────────────────────────────────────
//  INPUT
// ─────────────────────────────────────────────────────────────
function onTap(e) {
  e.preventDefault();

  if (state === 'start') {
    state = 'playing';
    score = 0; level = 1; combo = 0;
    gameOverGrey = 0; gameOverTimer = 0;
    bgCur = [...BG_THEMES[0]]; bgNext = [...BG_THEMES[0]]; bgT = 1;
    initGame();
    return;
  }

  if (state === 'gameover') {
    if (gameOverTimer > 55) {
      state = 'start';
    }
    return;
  }

  if (state === 'playing' && dropping && dropping.phase === 'hold') {
    dropping.phase = 'fall';
    dropping.vy = 0;
  }
}

canvas.addEventListener('pointerdown', onTap, { passive: false });
document.addEventListener('keydown', e => {
  if (e.code === 'Space' || e.code === 'ArrowDown') onTap(e);
});

// ─────────────────────────────────────────────────────────────
//  MAIN LOOP
// ─────────────────────────────────────────────────────────────
function loop() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  drawBG();

  if (state === 'start') {
    drawStartScreen();
    drawParticles();
    tickParticles();
  } else {
    // Update
    tickPlatform();
    tickDropping();
    tickStackSquish();
    tickParticles();
    tickTexts();

    // Draw
    drawWorld();
    drawParticles();
    drawTexts();
    drawHUD();
    drawLevelUpBanner();

    if (state === 'gameover') drawGameOver();
  }

  requestAnimationFrame(loop);
}

// ─────────────────────────────────────────────────────────────
//  BOOT
// ─────────────────────────────────────────────────────────────
spawnConfetti(18);
requestAnimationFrame(loop);
</script>
